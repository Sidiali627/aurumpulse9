# ============================================================================
# AurumPulse ICT - Environment Configuration Template (Demo / Render)
# DO NOT commit real secrets or private identifiers to source control.
# Copy this file to .env for local testing or set in Render Dashboard.
# ============================================================================

# HTTP Server Configuration
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# DEMO MODE ENFORCEMENT
# When set to true (recommended for public demo), real trading execution and
# outgoing live signal broadcasts to Telegram subscribers are disabled.
DEMO_MODE=true

# Telegram Bot API Token from @BotFather (Leave empty or placeholder for demo)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Master Administrator Telegram Chat ID
ADMIN_CHAT_ID=YOUR_TELEGRAM_ADMIN_CHAT_ID_HERE

# Contact Username for Purchasing & Support
ADMIN_CONTACT_USER=@alpha34

# Optional: Persistent PostgreSQL Database URL (Render PostgreSQL)
# Example: postgresql://aurumpulse_user:secret_password@dpg-xxxxx-a.frankfurt-postgres.render.com/aurumpulse_db
# If left unset, the engine will use local JSON storage with fallback to database.demo.json
DATABASE_URL=
